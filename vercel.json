{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/orders/:identifier", "destination": "/api/orders/[identifier]" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api|robots\\.txt|sitemap\\.xml|.*\\..*).*)", "destination": "/index.html" }
  ]
}
